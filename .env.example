# Public HTTP port mapped on the host (default: 8585)
PORT=8585

# Database file path inside the container
DB_PATH=/data/optimanager.db

# Time zone
TZ=America/Sao_Paulo

# HMAC secret for signing session tokens (minimum 32 characters)
# Run './scripts/init-env.sh' to automatically generate a cryptographically secure key.
# This example placeholder value is intentionally rejected on server startup.
JWT_SECRET=CONFIGURE_UMA_CHAVE_COM_PELO_MENOS_32_CHARS_AQUI
