# Porta pública mapeada no host (ex: 8080 ou 3000)
PORT=8080

# Caminho do arquivo de banco no contêiner
DB_PATH=/data/optimanager.db

# Fuso horário
TZ=America/Sao_Paulo

# Segredo HMAC para assinatura de sessões e tokens (mínimo 32 caracteres)
# Execute './scripts/init-env.sh' para gerar uma chave segura automaticamente.
# Este valor de exemplo é intencionalmente rejeitado na inicialização do servidor.
JWT_SECRET=CONFIGURE_UMA_CHAVE_COM_PELO_MENOS_32_CHARS_AQUI
